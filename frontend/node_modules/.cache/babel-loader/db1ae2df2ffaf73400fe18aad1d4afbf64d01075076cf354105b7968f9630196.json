rder-bottom: 1px dashed var(--border-color);\n  font-size: 1.05em;\n}\n\n.task-item:last-child {\n  border-bottom: none;\n}\n\n.task-time {\n  font-weight: bold;\n  color: var(--primary-color);\n  margin-right: 15px;\n  min-width: 60px;\n}\n\n.task-content {\n  flex-grow: 1;\n  color: var(--text-dark);\n}\n\n.task-priority {\n  margin-left: 10px;\n  padding: 4px 10px;\n  border-radius: 15px;\n  font-size: 0.85em;\n  color: white;\n  min-width: 40px;\n  text-align: center;\n}\n\n.priority-high .task-priority {\n  background-color: #e74c3c; /* Red */\n}\n\n.priority-medium .task-priority {\n  background-color: #f39c12; /* Orange */\n}\n\n.priority-low .task-priority {\n  background-color: #2ecc71; /* Green */\n}\n\n.no-tasks-message {\n  text-align: center;\n  color: #6c757d;\n  font-style: italic;\n  padding: 20px;\n}\n</style>\n"],"mappings":";;EACOA,KAAK,EAAC;AAAgB;;;EAEDA,KAAK,EAAC;;;EAEpBA,KAAK,EAAC;AAAW;;EACjBA,KAAK,EAAC;AAAc;;EACpBA,KAAK,EAAC;AAAe;;;EAGrBA,KAAK,EAAC;;;uBATlBC,mBAAA,CAUM,OAVNC,UAUM,GATJC,mBAAA,CAAoB,YAAAC,gBAAA,CAAbC,MAAA,CAAAC,KAAK,kBACFD,MAAA,CAAAE,KAAK,CAACC,MAAM,I,cAAtBP,mBAAA,CAMK,MANLQ,UAMK,I,kBALHR,mBAAA,CAIKS,SAAA,QAAAC,WAAA,CAJcN,MAAA,CAAAE,KAAK,EAAbK,IAAI;yBAAfX,mBAAA,CAIK;MAJsBY,GAAG,EAAED,IAAI,CAACE,EAAE;MAAGd,KAAK,EAAAe,eAAA,eAAgBC,QAAA,CAAAC,gBAAgB,CAACL,IAAI,CAACM,QAAQ;QAC3Ff,mBAAA,CAA0D,QAA1DgB,UAA0D,EAAAf,gBAAA,CAA/BY,QAAA,CAAAI,UAAU,CAACR,IAAI,CAACS,IAAI,mBAC/ClB,mBAAA,CAAoD,QAApDmB,UAAoD,EAAAlB,gBAAA,CAAtBQ,IAAI,CAACW,OAAO,kBAC1CpB,mBAAA,CAAyE,QAAzEqB,UAAyE,EAA7C,GAAC,GAAApB,gBAAA,CAAGY,QAAA,CAAAS,eAAe,CAACb,IAAI,CAACM,QAAQ,KAAI,GAAC,gB;qDAGtEjB,mBAAA,CAAgD,KAAhDyB,UAAgD,EAAb,WAAS,G","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}