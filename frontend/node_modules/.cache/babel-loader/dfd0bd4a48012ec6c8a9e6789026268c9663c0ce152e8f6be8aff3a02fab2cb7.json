  align-items: center;\n}\n\nli:last-child {\n  border-bottom: none;\n}\n\n.task-time {\n  font-weight: bold;\n  color: #555;\n  margin-right: 10px;\n  min-width: 50px; /* Ensure time aligns */\n}\n\n.task-content {\n  flex-grow: 1;\n  color: #333;\n}\n\n.task-priority {\n  margin-left: 10px;\n  padding: 3px 8px;\n  border-radius: 12px;\n  font-size: 0.8em;\n  color: white;\n}\n\n.priority-high .task-priority {\n  background-color: #e74c3c; /* Red */\n}\n\n.priority-medium .task-priority {\n  background-color: #f39c12; /* Orange */\n}\n\n.priority-low .task-priority {\n  background-color: #2ecc71; /* Green */\n}\n</style>\n"],"mappings":";;EACOA,KAAK,EAAC;AAAgB;;;;;EAIfA,KAAK,EAAC;AAAW;;EACjBA,KAAK,EAAC;AAAc;;EACpBA,KAAK,EAAC;AAAe;;;;;uBANjCC,mBAAA,CAUM,OAVNC,UAUM,GATJC,mBAAA,CAAoB,YAAAC,gBAAA,CAAbC,MAAA,CAAAC,KAAK,kBACFD,MAAA,CAAAE,KAAK,CAACC,MAAM,I,cAAtBP,mBAAA,CAMK,MAAAQ,UAAA,I,kBALHR,mBAAA,CAIKS,SAAA,QAAAC,WAAA,CAJcN,MAAA,CAAAE,KAAK,EAAbK,IAAI;yBAAfX,mBAAA,CAIK;MAJsBY,GAAG,EAAED,IAAI,CAACE,EAAE;MAAGd,KAAK,EAAAe,eAAA,CAAEC,QAAA,CAAAC,gBAAgB,CAACL,IAAI,CAACM,QAAQ;QAC7Ef,mBAAA,CAA0D,QAA1DgB,UAA0D,EAAAf,gBAAA,CAA/BY,QAAA,CAAAI,UAAU,CAACR,IAAI,CAACS,IAAI,mB,2CAAW,KAC1D,qBAAAlB,mBAAA,CAAoD,QAApDmB,UAAoD,EAAAlB,gBAAA,CAAtBQ,IAAI,CAACW,OAAO,kBAC1CpB,mBAAA,CAAyE,QAAzEqB,UAAyE,EAA7C,GAAC,GAAApB,gBAAA,CAAGY,QAAA,CAAAS,eAAe,CAACb,IAAI,CAACM,QAAQ,KAAI,GAAC,gB;qDAGtEjB,mBAAA,CAAuB,KAAAyB,UAAA,EAAb,WAAS,G","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}