{"ast":null,"code":"export default {\n  name: 'AddEditModal',\n  props: {\n    isVisible: Boolean,\n    task: Object // The task object to be edited (optional)\n  },\n  data() {\n    return {\n      taskForm: {\n        id: null,\n        content: '',\n        date: '',\n        time: '',\n        priority: 2 // Default to medium priority\n      }\n    };\n  },\n  watch: {\n    task: {\n      immediate: true,\n      handler(newTask) {\n        if (newTask) {\n          this.taskForm = {\n            id: newTask.id || null,\n            content: newTask.content || '',\n            // Ensure date is in 'YYYY-MM-DD' format for input type=\"date\"\n            date: newTask.date instanceof Date ? newTask.date.toISOString().split('T')[0] : newTask.date || '',\n            // Ensure time is in 'HH:MM' format for input type=\"time\"\n            time: newTask.time ? newTask.time.substring(0, 5) : '',\n            priority: newTask.priority || 2\n          };\n        } else {\n          this.resetForm();\n        }\n      }\n    },\n    isVisible(newVal) {\n      if (!newVal) {\n        this.resetForm();\n      }\n    }\n  },\n  methods: {\n    saveTask() {\n      // Emit the taskForm data to the parent component\n      this.$emit('save', this.taskForm);\n      this.resetForm();\n    },\n    cancel() {\n      this.$emit('close');\n      this.resetForm();\n    },\n    resetForm() {\n      this.taskForm = {\n        id: null,\n        content: '',\n        date: '',\n        time: '',\n        priority: 2\n      };\n    }\n  }\n};","map":{"version":3,"names":["name","props","isVisible","Boolean","task","Object","data","taskForm","id","content","date","time","priority","watch","immediate","handler","newTask","Date","toISOString","split","substring","resetForm","newVal","methods","saveTask","$emit","cancel"],"sources":["C:\\Users\\user\\Documents\\aiproject\\personal-schedule-app\\frontend\\src\\components\\AddEditModal.vue"],"sourcesContent":["<template>\n  <div class=\"modal-overlay\" v-if=\"isVisible\">\n    <div class=\"modal-content card\">\n      <h2>{{ currentTask && currentTask.id ? '編輯行程' : '新增行程' }}</h2>\n      <form @submit.prevent=\"saveTask\">\n        <div class=\"form-group\">\n          <label for=\"content\">內容:</label>\n          <input type=\"text\" id=\"content\" v-model=\"taskForm.content\" required />\n        </div>\n        <div class=\"form-group\">\n          <label for=\"date\">日期:</label>\n          <input type=\"date\" id=\"date\" v-model=\"taskForm.date\" required />\n        </div>\n        <div class=\"form-group\">\n          <label for=\"time\">時間 (可選):</label>\n          <input type=\"time\" id=\"time\" v-model=\"taskForm.time\" />\n        </div>\n        <div class=\"form-group\">\n          <label for=\"priority\">緊急程度:</label>\n          <select id=\"priority\" v-model.number=\"taskForm.priority\">\n            <option :value=\"1\">高</option>\n            <option :value=\"2\">中</option>\n            <option :value=\"3\">低</option>\n          </select>\n        </div>\n        <div class=\"form-actions\">\n          <button type=\"submit\" class=\"save-button\">儲存</button>\n          <button type=\"button\" @click=\"cancel\" class=\"cancel-button\">取消</button>\n        </div>\n      </form>\n    </div>\n  </div>\n</template>\n\n<script>\nexport default {\n  name: 'AddEditModal',\n  props: {\n    isVisible: Boolean,\n    task: Object, // The task object to be edited (optional)\n  },\n  data() {\n    return {\n      taskForm: {\n        id: null,\n        content: '',\n        date: '',\n        time: '',\n        priority: 2, // Default to medium priority\n      },\n    };\n  },\n  watch: {\n    task: {\n      immediate: true,\n      handler(newTask) {\n        if (newTask) {\n          this.taskForm = {\n            id: newTask.id || null,\n            content: newTask.content || '',\n            // Ensure date is in 'YYYY-MM-DD' format for input type=\"date\"\n            date: newTask.date instanceof Date ? newTask.date.toISOString().split('T')[0] : newTask.date || '',\n            // Ensure time is in 'HH:MM' format for input type=\"time\"\n            time: newTask.time ? newTask.time.substring(0, 5) : '',\n            priority: newTask.priority || 2,\n          };\n        } else {\n          this.resetForm();\n        }\n      },\n    },\n    isVisible(newVal) {\n      if (!newVal) {\n        this.resetForm();\n      }\n    }\n  },\n  methods: {\n    saveTask() {\n      // Emit the taskForm data to the parent component\n      this.$emit('save', this.taskForm);\n      this.resetForm();\n    },\n    cancel() {\n      this.$emit('close');\n      this.resetForm();\n    },\n    resetForm() {\n      this.taskForm = {\n        id: null,\n        content: '',\n        date: '',\n        time: '',\n        priority: 2,\n      };\n    },\n  },\n};\n</script>\n\n<style scoped>\n.modal-overlay {\n  position: fixed;\n  top: 0;\n  left: 0;\n  width: 100%;\n  height: 100%;\n  background-color: rgba(0, 0, 0, 0.6);\n  display: flex;\n  justify-content: center;\n  align-items: center;\n  z-index: 1000;\n}\n\n.modal-content {\n  background-color: #fff;\n  padding: 30px;\n  border-radius: 10px;\n  box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);\n  width: 100%;\n  max-width: 500px;\n}\n\nh2 {\n  text-align: center;\n  color: var(--secondary-color);\n  margin-bottom: 25px;\n  font-size: 1.8em;\n}\n\n.form-group {\n  margin-bottom: 20px;\n}\n\nlabel {\n  display: block;\n  margin-bottom: 8px;\n  font-weight: bold;\n  color: var(--text-dark);\n}\n\ninput[type=\"text\"],\ninput[type=\"date\"],\ninput[type=\"time\"],\nselect {\n  width: calc(100% - 22px); /* Adjusting for padding and border */\n  padding: 12px 10px;\n  border: 1px solid var(--border-color);\n  border-radius: 5px;\n  font-size: 1em;\n  box-sizing: border-box;\n  background-color: var(--background-light);\n  color: var(--text-dark);\n}\n\ninput[type=\"text\"]:focus,\ninput[type=\"date\"]:focus,\ninput[type=\"time\"]:focus,\nselect:focus {\n  border-color: var(--primary-color);\n  outline: none;\n  box-shadow: 0 0 5px rgba(66, 185, 131, 0.5);\n}\n\n.form-actions {\n  display: flex;\n  justify-content: flex-end;\n  gap: 15px;\n  margin-top: 30px;\n}\n\n.save-button, .cancel-button {\n  padding: 12px 25px;\n  border: none;\n  border-radius: 5px;\n  cursor: pointer;\n  font-size: 1em;\n  transition: background-color 0.3s ease;\n}\n\n.save-button {\n  background-color: var(--primary-color);\n  color: white;\n}\n\n.save-button:hover {\n  background-color: #36a074;\n}\n\n.cancel-button {\n  background-color: #6c757d;\n  color: white;\n}\n\n.cancel-button:hover {\n  background-color: #5a6268;\n}\n</style>\n"],"mappings":"AAmCA,eAAe;EACbA,IAAI,EAAE,cAAc;EACpBC,KAAK,EAAE;IACLC,SAAS,EAAEC,OAAO;IAClBC,IAAI,EAAEC,MAAM,CAAE;EAChB,CAAC;EACDC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,QAAQ,EAAE;QACRC,EAAE,EAAE,IAAI;QACRC,OAAO,EAAE,EAAE;QACXC,IAAI,EAAE,EAAE;QACRC,IAAI,EAAE,EAAE;QACRC,QAAQ,EAAE,CAAC,CAAE;MACf;IACF,CAAC;EACH,CAAC;EACDC,KAAK,EAAE;IACLT,IAAI,EAAE;MACJU,SAAS,EAAE,IAAI;MACfC,OAAOA,CAACC,OAAO,EAAE;QACf,IAAIA,OAAO,EAAE;UACX,IAAI,CAACT,QAAO,GAAI;YACdC,EAAE,EAAEQ,OAAO,CAACR,EAAC,IAAK,IAAI;YACtBC,OAAO,EAAEO,OAAO,CAACP,OAAM,IAAK,EAAE;YAC9B;YACAC,IAAI,EAAEM,OAAO,CAACN,IAAG,YAAaO,IAAG,GAAID,OAAO,CAACN,IAAI,CAACQ,WAAW,CAAC,CAAC,CAACC,KAAK,CAAC,GAAG,CAAC,CAAC,CAAC,IAAIH,OAAO,CAACN,IAAG,IAAK,EAAE;YAClG;YACAC,IAAI,EAAEK,OAAO,CAACL,IAAG,GAAIK,OAAO,CAACL,IAAI,CAACS,SAAS,CAAC,CAAC,EAAE,CAAC,IAAI,EAAE;YACtDR,QAAQ,EAAEI,OAAO,CAACJ,QAAO,IAAK;UAChC,CAAC;QACH,OAAO;UACL,IAAI,CAACS,SAAS,CAAC,CAAC;QAClB;MACF;IACF,CAAC;IACDnB,SAASA,CAACoB,MAAM,EAAE;MAChB,IAAI,CAACA,MAAM,EAAE;QACX,IAAI,CAACD,SAAS,CAAC,CAAC;MAClB;IACF;EACF,CAAC;EACDE,OAAO,EAAE;IACPC,QAAQA,CAAA,EAAG;MACT;MACA,IAAI,CAACC,KAAK,CAAC,MAAM,EAAE,IAAI,CAAClB,QAAQ,CAAC;MACjC,IAAI,CAACc,SAAS,CAAC,CAAC;IAClB,CAAC;IACDK,MAAMA,CAAA,EAAG;MACP,IAAI,CAACD,KAAK,CAAC,OAAO,CAAC;MACnB,IAAI,CAACJ,SAAS,CAAC,CAAC;IAClB,CAAC;IACDA,SAASA,CAAA,EAAG;MACV,IAAI,CAACd,QAAO,GAAI;QACdC,EA