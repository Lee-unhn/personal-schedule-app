{"ast":null,"code":"export default {\n  name: 'UpcomingTasks',\n  props: {\n    title: String,\n    tasks: Array\n  },\n  methods: {\n    formatTime(time) {\n      if (!time) return '全天';\n      const [hour, minute] = time.split(':');\n      return `${hour}:${minute}`;\n    },\n    getPriorityText(priority) {\n      switch (priority) {\n        case 1:\n          return '高';\n        case 2:\n          return '中';\n        case 3:\n          return '低';\n        default:\n          return '未知';\n      }\n    },\n    getPriorityClass(priority) {\n      switch (priority) {\n        case 1:\n          return 'priority-high';\n        case 2:\n          return 'priority-medium';\n        case 3:\n          return 'priority-low';\n        default:\n          return '';\n      }\n    }\n  }\n};","map":{"version":3,"names":["name","props","title","String","tasks","Array","methods","formatTime","time","hour","minute","split","getPriorityText","priority","getPriorityClass"],"sources":["C:\\Users\\user\\Documents\\aiproject\\personal-schedule-app\\frontend\\src\\components\\UpcomingTasks.vue"],"sourcesContent":["<template>\n  <div class=\"upcoming-tasks\">\n    <h2>{{ title }}</h2>\n    <ul v-if=\"tasks.length\" class=\"task-list\">\n      <li v-for=\"task in tasks\" :key=\"task.id\" :class=\"['task-item', getPriorityClass(task.priority)]\">\n        <span class=\"task-time\">{{ formatTime(task.time) }}</span>\n        <span class=\"task-content\">{{ task.content }}</span>\n        <span class=\"task-priority\">({{ getPriorityText(task.priority) }})</span>\n      </li>\n    </ul>\n    <p v-else class=\"no-tasks-message\">目前沒有預定活動。</p>\n  </div>\n</template>\n\n<script>\nexport default {\n  name: 'UpcomingTasks',\n  props: {\n    title: String,\n    tasks: Array,\n  },\n  methods: {\n    formatTime(time) {\n      if (!time) return '全天';\n      const [hour, minute] = time.split(':');\n      return `${hour}:${minute}`;\n    },\n    getPriorityText(priority) {\n      switch (priority) {\n        case 1:\n          return '高';\n        case 2:\n          return '中';\n        case 3:\n          return '低';\n        default:\n          return '未知';\n      }\n    },\n    getPriorityClass(priority) {\n      switch (priority) {\n        case 1:\n          return 'priority-high';\n        case 2:\n          return 'priority-medium';\n        case 3:\n          return 'priority-low';\n        default:\n          return '';\n      }\n    },\n  },\n};\n</script>\n\n<style scoped>\n.upcoming-tasks {\n  /* Removed card styles as they are now in DashboardView.vue */\n}\n\nh2 {\n  color: var(--secondary-color);\n  border-bottom: 2px solid var(--border-color);\n  padding-bottom: 10px;\n  margin-top: 0;\n  margin-bottom: 20px;\n  font-size: 1.5em;\n  text-align: center;\n}\n\n.task-list {\n  list-style: none;\n  padding: 0;\n}\n\n.task-item {\n  display: flex;\n  align-items: center;\n  padding: 12px 0;\n  border-bottom: 1px dashed var(--border-color);\n  font-size: 1.05em;\n}\n\n.task-item:last-child {\n  border-bottom: none;\n}\n\n.task-time {\n  font-weight: bold;\n  color: var(--primary-color);\n  margin-right: 15px;\n  min-width: 60px;\n}\n\n.task-content {\n  flex-grow: 1;\n  color: var(--text-dark);\n}\n\n.task-priority {\n  margin-left: 10px;\n  padding: 4px 10px;\n  border-radius: 15px;\n  font-size: 0.85em;\n  color: white;\n  min-width: 40px;\n  text-align: center;\n}\n\n.priority-high .task-priority {\n  background-color: #e74c3c; /* Red */\n}\n\n.priority-medium .task-priority {\n  background-color: #f39c12; /* Orange */\n}\n\n.priority-low .task-priority {\n  background-color: #2ecc71; /* Green */\n}\n\n.no-tasks-message {\n  text-align: center;\n  color: #6c757d;\n  font-style: italic;\n  padding: 20px;\n}\n</style>\n"],"mappings":"AAeA,eAAe;EACbA,IAAI,EAAE,eAAe;EACrBC,KAAK,EAAE;IACLC,KAAK,EAAEC,MAAM;IACbC,KAAK,EAAEC;EACT,CAAC;EACDC,OAAO,EAAE;IACPC,UAAUA,CAACC,IAAI,EAAE;MACf,IAAI,CAACA,IAAI,EAAE,OAAO,IAAI;MACtB,MAAM,CAACC,IAAI,EAAEC,MAAM,IAA