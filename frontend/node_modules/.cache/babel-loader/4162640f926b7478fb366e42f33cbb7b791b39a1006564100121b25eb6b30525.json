k: $event => $options.toggleComplete(task),\n      class: \"complete-button icon-button\"\n    }, [...(_cache[4] || (_cache[4] = [_createElementVNode(\"i\", {\n      class: \"fas fa-check-circle\"\n    }, null, -1 /* CACHED */)]))], 8 /* PROPS */, _hoisted_13)) : (_openBlock(), _createElementBlock(\"button\", {\n      key: 1,\n      onClick: $event => $options.toggleComplete(task),\n      class: \"incomplete-button icon-button\"\n    }, [...(_cache[5] || (_cache[5] = [_createElementVNode(\"i\", {\n      class: \"fas fa-times-circle\"\n    }, null, -1 /* CACHED */)]))], 8 /* PROPS */, _hoisted_14))])], 2 /* CLASS */);\n  }), 128 /* KEYED_FRAGMENT */))])) : (_openBlock(), _createElementBlock(\"p\", _hoisted_15, \"本日無行程。\"))])) : _createCommentVNode(\"v-if\", true)]), _createVNode(_component_AddEditModal, {\n    isVisible: $data.showModal,\n    task: $data.currentTask,\n    onClose: $options.closeModal,\n    onSave: $options.handleSaveTask\n  }, null, 8 /* PROPS */, [\"isVisible\", \"task\", \"onClose\", \"onSave\"])]);\n}","map":{"version":3,"names":["class","_createElementBlock","_hoisted_1","_createElementVNode","_hoisted_2","onClick","_cache","args","$options","openAddModal","_hoisted_3","_hoisted_4","_createVNode","_component_VCalendar","attributes","calendarAttributes","fetchTasksForMonth","onDayclick","onDayClick","locale","$data","selectedDate","_hoisted_5","_toDisplayString","toLocaleDateString","weekday","year","month","day","selectedDayTasks","length","_hoisted_6","_Fragment","_renderList","task","key","id","_normalizeClass","getPriorityClass","priority","completed","_hoisted_7","formatTime","time","_hoisted_8","content","_hoisted_9","getPriorityText","_hoisted_10","$event","editTask","deleteTask","toggleComplete","_hoisted_15","_component_AddEditModal","isVisible","showModal","currentTask","onClose","closeModal","onSave","handleSaveTask"],"sources":["C:\\Users\\user\\Documents\\aiproject\\personal-schedule-app\\frontend\\src\\views\\CalendarView.vue"],"sourcesContent":["<template>\n  <div class=\"calendar-view-container\">\n    <div class=\"calendar-header\">\n      <h1>日曆</h1>\n      <button @click=\"openAddModal\" class=\"add-task-button\">新增行程</button>\n    </div>\n    <div class=\"calendar-and-tasks\">\n      <div class=\"calendar-wrapper card\">\n        <VCalendar\n          class=\"custom-calendar\"\n          :attributes=\"calendarAttributes\"\n          @update:from-page=\"fetchTasksForMonth\"\n          @dayclick=\"onDayClick\"\n          is-expanded\n          locale=\"zh-TW\"\n        />\n      </div>\n      <div class=\"selected-day-tasks card\" v-if=\"selectedDate\">\n        <h2>{{ selectedDate.toLocaleDateString('zh-TW', { weekday: 'long', year: 'numeric', month: 'numeric', day: 'numeric' }) }} 的行程</h2>\n        <ul v-if=\"selectedDayTasks.length\" class=\"task-list\">\n          <li v-for=\"task in selectedDayTasks\" :key=\"task.id\" :class=\"['task-item', getPriorityClass(task.priority), { 'task-completed': task.completed }]\">\n            <span class=\"task-time\">{{ formatTime(task.time) }}</span>\n            <span class=\"task-content\">{{ task.content }}</span>\n            <span class=\"task-priority\">({{ getPriorityText(task.priority) }})</span>\n            <div class=\"task-actions\">\n              <button @click=\"editTask(task)\" class=\"edit-button icon-button\">\n                <i class=\"fas fa-edit\"></i>\n              </button>\n              <button @click=\"deleteTask(task.id)\" class=\"delete-button icon-button\">\n                <i class=\"fas fa-trash-alt\"></i>\n              </button>\n              <button v-if=\"!task.completed\" @click=\"toggleComplete(task)\" class=\"complete-button icon-button\">\n                <i class=\"fas fa-check-circle\"></i>\n              </button>\n              <button v-else @click=\"toggleComplete(task)\" class=\"incomplete-button icon-button\">\n                <i class=\"fas fa-times-circle\"></i>\n              </button>\n            </div>\n          </li>\n        </ul>\n        <p v-else class=\"no-tasks-message\">本日無行程。</p>\n      </div>\n    </div>\n\n    <AddEditModal\n      :isVisible=\"showModal\"\n      :task=\"currentTask\"\n      @close=\"closeModal\"\n      @save=\"handleSaveTask\"\n    />\n  </div>\n</template>\n\n<script>\nimport axios from 'axios';\nimport { Calendar } from 'v-calendar';\nimport 'v-calendar/dist/style.css';\nimport AddEditModal from '@/components/AddEditModal.vue';\n\nexport default {\n  name: 'CalendarView',\n  components: {\n    VCalendar: Calendar,\n    AddEditModal,\n  },\n  data() {\n    return {\n      allTasks: [],\n      selectedDate: null,\n      selectedDayTasks: [],\n      showModal: false,\n      currentTask: null, // For editing or new task\n    };\n  },\n  computed: {\n    calendarAttributes() {\n      return this.allTasks.map(task => ({\n        key: task.id,\n        dot: {\n          color: this.getPriorityColor(task.priority),\n          class: task.completed ? 'opacity-75' : '',\n        },\n        popover: {\n          label: `${this.formatTime(task.time)} ${this.getPriorityText(task.priority)} ${task.content}`,\n        },\n        dates: new Date(task.date),\n      }));\n    },\n  },\n  created() {\n    this.fetchTasksForMonth({ month: new Date().getMonth() + 1, year: new Date().getFullYear() });\n    this.selectedDate = new Date(); // Default to today\n  },\n  watch: {\n    selectedDate(newDate) {\n      this.filterTasksForSelectedDay(newDate);\n    },\n    allTasks: {\n      handler() {\n        this.filterTasksForSelectedDay(this.selectedDate);\n      },\n      deep: true,\n    }\n  },\n  methods: {\n    async fetchTasksForMonth(page) {\n      const year = page.year;\n      const month = String(page.month).padStart(2, '0');\n      const startDate = `${year}-${month}-01`;\n      const endDate = `${year}-${month}-${new Date(year, month, 0).getDate()}`; // Last day of the month\n\n      try {\n        const response = await axios.get(`http://localhost:5000/todos?start_date=${startDate}&end_date=${endDate}`);\n        this.allTasks = response.data;\n      } catch (error) {\n        console.error('Error fetching tasks for month:', error);\n      }\n    },\n    onDayClick(day) {\n      this.selectedDate = day.date;\n    },\n    filterTasksForSelectedDay(date) {\n      if (!date) {\n        this.selectedDayTasks = [];\n        return;\n      }\n      const selectedDateISO = date.toISOString().split('T')[0];\n      this.selectedDayTasks = this.allTasks.filter(\n        task => task.date === selectedDateISO\n      ).sort((a, b) => {\n        if (!a.time && !b.time) return 0;\n        if (!a.time) return 1;\n        if (!b.time) return -1;\n        return a.time.localeCompare(b.time);\n      });\n    },\n    openAddModal() {\n      this.currentTask = { date: this.selectedDate ? this.selectedDate.toISOString().split('T')[0] : new Date().toISOString().split('T')[0] };\n      this.showModal = true;\n    },\n    editTask(task) {\n      this.currentTask = { ...task, date: new Date(task.date), time: task.time ? task.time.substring(0, 5) : '' };\n      this.showModal = true;\n    },\n    async handleSaveTask(task) {\n      try {\n        if (task.id) {\n          // Update existing task\n          const response = await axios.put(`http://localhost:5000/todos/${task.id}`, task);\n          this.allTasks = this.allTasks.map(t => (t.id === task.id ? response.data : t));\n        } else {\n          // Add new task\n          const response = await axios.post('http://localhost:5000/todos', task);\n          this.allTasks.push(response.data);\n        }\n        this.closeModal();\n      } catch (error) {\n        console.error('Error saving task:', error);\n      }\n    },\n    async deleteTask(id) {\n      if (confirm('確定要刪除此行程嗎？')) {\n        try {\n          await axios.delete(`http://localhost:5000/todos/${id}`);\n          this.allTasks = this.allTasks.filter(task => task.id !== id);\n        } catch (error) {\n          console.error('Error deleting task:', error);\n        }\n      }\n    },\n    async toggleComplete(task) {\n      try {\n        const updatedTask = { ...task, completed: !task.completed };\n        const response = await axios.put(`http://localhost:5000/todos/${task.id}`, updatedTask);\n        this.allTasks = this.allTasks.map(t => (t.id === task.id ? response.data : t));\n      } catch (error) {\n        console.error('Error toggling task completion:', error);\n      }\n    },\n    closeModal() {\n      this.showModal = false;\n      this.currentTask = null;\n    },\n    formatTime(time) {\n      if (!time) return '全天';\n      const [hour, minute] = time.split(':');\n      return `${hour}:${minute}`;\n    },\n    getPriorityText(priority) {\n      switch (priority) {\n        case 1: return '高';\n        case 2: return '中';\n        case 3: return '低';\n        default: return '未知';\n      }\n    },\n    getPriorityClass(priority) {\n      switch (priority) {\n        case 1: return 'priority-high';\n        case 2: return 'priority-medium';\n        case 3: return 'priority-low';\n        default: return '';\n      }\n    },\n    getPriorityColor(priority) {\n      switch (priority) {\n        case 1: return 'red';\n        case 2: return 'orange';\n        case 3: return 'green';\n        default: return 'gray';\n      }\n    },\n  },\n};\n</script>\n\n<style scoped>\n.calendar-view-container {\n  padding: 20px;\n  max-width: 1200px;\n  margin: 0 auto;\n}\n\n.calendar-header {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  margin-bottom: 20px;\n}\n\nh1 {\n  color: var(--secondary-color);\n  font-size: 2.2em;\n  margin: 0;\n}\n\n.add-task-button {\n  background-color: var(--primary-color);\n  color: white;\n  border: none;\n  padding: 10px 15px;\n  border-radius: 5px;\n  cursor: pointer;\n  font-size: 1em;\n  transition: background-color 0.3s ease;\n}\n\n.add-task-button:hover {\n  background-color: #36a074;\n}\n\n.calendar-and-tasks {\n  display: grid;\n  grid-template-columns: 1fr;\n  gap: 25px;\n}\n\n@media (min-width: 992px) {\n  .calendar-and-tasks {\n    grid-template-columns: 2fr 1fr;\n  }\n}\n\n.card {\n  /* Global card styles are in App.vue */\n  box-shadow: var(--shadow-md);\n  padding: 20px;\n}\n\n.calendar-wrapper {\n  background-color: white;\n  border-radius: 10px;\n  padding: 15px;\n}\n\n.custom-calendar {\n  height: 100%;\n}\n\n.selected-day-tasks {\n  background-color: white;\n  border-radius: 10px;\n  padding: 20px;\n}\n\n.selected-day-tasks h2 {\n  color: var(--secondary-color);\n  border-bottom: 2px solid var(--border-color);\n  padding-bottom: 10px;\n  margin-top: 0;\n  margin-bottom: 20px;\n  font-size: 1.5em;\n  text-align: center;\n}\n\n.task-list {\n  list-style: none;\n  padding: 0;\n}\n\n.task-item {\n  display: flex;\n  flex-wrap: wrap;\n  align-items: center;\n  padding: 12px 0;\n  border-bottom: 1px dashed var(--border-color);\n  font-size: 1.05em;\n}\n\n.task-item:last-child {\n  border-bottom: none;\n}\n\n.task-completed .task-content, .task-completed .task-time {\n  text-decoration: line-through;\n  color: #6c757d;\n}\n\n.task-time {\n  font-weight: bold;\n  color: var(--primary-color);\n  margin-right: 15px;\n  min-width: 60px;\n}\n\n.task-content {\n  flex-grow: 1;\n  color: var(--text-dark);\n}\n\n.task-priority {\n  margin-left: 10px;\n  padding: 4px 10px;\n  border-radius: 15px;\n  font-size: 0.85em;\n  color: white;\n  min-width: 40px;\n  text-align: center;\n}\n\n/* Priority specific styles */\n.priority-high .task-priority {\n  background-color: #e74c3c; /* Red */\n}\n\n.priority-medium .task-priority {\n  background-color: #f39c12; /* Orange */\n}\n\n.priority-low .task-priority {\n  background-color: #2ecc71; /* Green */\n}\n\n.task-actions {\n  margin-left: auto;\n  display: flex;\n  gap: 8px;\n  flex-shrink: 0;\n}\n\n.task-actions .icon-button {\n  background: none;\n  border: none;\n  color: var(--secondary-color);\n  cursor: pointer;\n  padding: 5px;\n  font-size: 1.1em;\n  transition: color 0.3s ease;\n}\n\n.task-actions .icon-button:hover {\n  color: var(--primary-color);\n}\n\n.edit-button { color: #007bff; }\n.delete-button { color: #dc3545; }\n.complete-button { color: #28a745; }\n.incomplete-button { color: #6c757d; }\n\n.edit-button:hover { color: #0056b3; }\n.delete-button:hover { color: #c82333; }\n.complete-button:hover { color: #218838; }\n.incomplete-button:hover { color: #5a6268; }\n\n\n.no-tasks-message {\n  text-align: center;\n  color: #6c757d;\n  font-style: italic;\n  padding: 20px;\n}\n\n/* V-Calendar specific overrides for better styling */\n.vc-container {\n  border: none !important; /* Remove default border */\n  border-radius: 8px !important;\n  font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif !important;\n}\n\n.vc-header {\n  background-color: var(--background-dark) !important;\n  padding: 10px 0 !important;\n  border-bottom: 1px solid var(--border-color) !important;\n}\n\n.vc-title {\n  color: var(--secondary-color) !important;\n  font-weight: bold !important;\n}\n\n.vc-arrow {\n  color: var(--primary-color) !important;\n}\n\n.vc-weeks {\n  padding: 10px 0 !important;\n}\n\n.vc-day {\n  border-radius: 5px !important;\n}\n\n.vc-day-content {\n  font-weight: normal !important;\n  color: var(--text-dark) !important;\n}\n\n.vc-day.is-today .vc-day-content {\n  color: white !important;\n  background-color: var(--primary-color) !important;\n  border-radius: 50%;\n  font-weight: bold !important;\n}\n\n.vc-day.is-not-in-month .vc-day-content {\n  color: #ced4da !important;\n}\n\n/* Style for dots on calendar */\n.vc-dots span {\n  width: 6px;\n  height: 6px;\n  border-radius: 50%;\n  margin: 0 1px;\n}\n</style>\n"],"mappings":";;EACOA,KAAK,EAAC;AAAyB;;EAC7BA,KAAK,EAAC;AAAiB;;EAIvBA,KAAK,EAAC;AAAoB;;EACxBA,KAAK,EAAC;AAAuB;;;EAU7BA,KAAK,EAAC;;;;EAE0BA,KAAK,EAAC;;;EAE/BA,KAAK,EAAC;AAAW;;EACjBA,KAAK,EAAC;AAAc;;EACpBA,KAAK,EAAC;AAAe;;EACtBA,KAAK,EAAC;AAAc;;;;;;;EAgBnBA,KAAK