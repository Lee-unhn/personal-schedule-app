{"ast":null,"code":"export default {\n  name: 'App'\n};","map":{"version":3,"names":["name"],"sources":["C:\\Users\\user\\Documents\\aiproject\\personal-schedule-app\\frontend\\src\\App.vue"],"sourcesContent":["<template>\n  <div id=\"app\">\n    <header class=\"app-header\">\n      <nav class=\"main-nav\">\n        <router-link to=\"/\" class=\"nav-item\">儀表板</router-link>\n        <router-link to=\"/calendar\" class=\"nav-item\">日曆</router-link>\n      </nav>\n    </header>\n    <main class=\"app-main\">\n      <router-view/>\n    </main>\n  </div>\n</template>\n\n<script>\nexport default {\n  name: 'App',\n};\n</script>\n\n<style>\n/* Global Styles */\n:root {\n  --primary-color: #42b983;\n  --secondary-color: #34495e;\n  --background-light: #f8f9fa;\n  --background-dark: #e9ecef;\n  --text-dark: #2c3e50;\n  --text-light: #ecf0f1;\n  --border-color: #dee2e6;\n  --shadow-sm: rgba(0, 0, 0, 0.05) 0px 1px 2px 0px;\n  --shadow-md: rgba(0, 0, 0, 0.1) 0px 4px 6px -1px, rgba(0, 0, 0, 0.06) 0px 2px 4px -1px;\n}\n\nbody {\n  margin: 0;\n  font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;\n  -webkit-font-smoothing: antialiased;\n  -moz-osx-font-smoothing: grayscale;\n  background-color: var(--background-light);\n  color: var(--text-dark);\n  line-height: 1.6;\n}\n\n#app {\n  display: flex;\n  flex-direction: column;\n  min-height: 100vh;\n}\n\n.app-header {\n  background-color: var(--secondary-color);\n  padding: 15px 20px;\n  box-shadow: var(--shadow-md);\n}\n\n.main-nav {\n  display: flex;\n  justify-content: center;\n  gap: 30px;\n}\n\n.nav-item {\n  color: var(--text-light);\n  text-decoration: none;\n  font-weight: bold;\n  font-size: 1.1em;\n  padding: 5px 10px;\n  border-radius: 5px;\n  transition: background-color 0.3s ease, color 0.3s ease;\n}\n\n.nav-item:hover,\n.nav-item.router-link-exact-active {\n  background-color: var(--primary-color);\n  color: white;\n}\n\n.app-main {\n  flex-grow: 1;\n  padding: 20px;\n  max-width: 1200px;\n  margin: 0 auto;\n  width: 100%;\n}\n\n/* Base styles for containers/cards */\n.card {\n  background-color: white;\n  border-radius: 8px;\n  box-shadow: var(--shadow-sm);\n  padding: 20px;\n  margin-bottom: 20px;\n}\n\nh1, h2, h3, h4, h5, h6 {\n  color: var(--secondary-color);\n  margin-top: 0;\n  margin-bottom: 15px;\n}\n\nul {\n  list-style: none;\n  padding: 0;\n  margin: 0;\n}\n\nbutton {\n  background-color: var(--primary-color);\n  color: white;\n  border: none;\n  padding: 10px 15px;\n  border-radius: 5px;\n  cursor: pointer;\n  font-size: 1em;\n  transition: background-color 0.3s ease;\n}\n\nbutton:hover {\n  background-color: #36a074; /* A slightly darker primary color */\n}\n</style>\n"],"mappings":"AAeA,eAAe;EACbA,IAAI,EAAE;AACR,CAAC","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}