  <router-view/>\n    </main>\n  </div>\n</template>\n\n<script>\nexport default {\n  name: 'App',\n};\n</script>\n\n<style>\n/* Global Tech-Style Dark Theme */\n:root {\n  --primary-color: #00bcd4; /* Cyan */\n  --secondary-color: #212121; /* Dark Grey */\n  --background-dark: #121212; /* Very Dark Grey */\n  --background-light: #1e1e1e; /* Slightly Lighter Dark Grey */\n  --text-light: #e0e0e0; /* Light Grey for text */\n  --text-muted: #9e9e9e; /* Muted grey for secondary text */\n  --accent-color: #ff4081; /* Pink accent */\n  --border-color: #424242; /* Medium Dark Grey for borders */\n  --shadow-sm: rgba(0, 188, 212, 0.1) 0px 1px 3px 0px, rgba(0, 188, 212, 0.06) 0px 1px 2px 0px;\n  --shadow-md: rgba(0, 188, 212, 0.2) 0px 4px 6px -1px, rgba(0, 188, 212, 0.1) 0px 2px 4px -1px;\n}\n\nbody {\n  margin: 0;\n  font-family: 'Roboto Mono', monospace; /* Techy font */\n  -webkit-font-smoothing: antialiased;\n  -moz-osx-font-smoothing: grayscale;\n  background-color: var(--background-dark);\n  color: var(--text-light);\n  line-height: 1.6;\n}\n\n#app {\n  display: flex;\n  flex-direction: column;\n  min-height: 100vh;\n}\n\n.app-header {\n  background-color: var(--secondary-color);\n  padding: 15px 20px;\n  box-shadow: var(--shadow-md);\n  border-bottom: 2px solid var(--primary-color);\n}\n\n.main-nav {\n  display: flex;\n  justify-content: center;\n  gap: 30px;\n}\n\n.nav-item {\n  color: var(--text-light);\n  text-decoration: none;\n  font-weight: bold;\n  font-size: 1.1em;\n  padding: 8px 15px;\n  border-radius: 5px;\n  transition: background-color 0.3s ease, color 0.3s ease, border-color 0.3s ease;\n  border: 1px solid transparent;\n}\n\n.nav-item:hover,\n.nav-item.router-link-exact-active {\n  background-color: var(--primary-color);\n  color: var(--secondary-color);\n  border-color: var(--primary-color);\n}\n\n.app-main {\n  flex-grow: 1;\n  padding: 20px;\n  max-width: 1400px; /* Wider main content area */\n  margin: 0 auto;\n  width: 100%;\n}\n\n/* Base styles for containers/cards */\n.card {\n  background-color: var(--background-light);\n  border-radius: 8px;\n  box-shadow: var(--shadow-sm);\n  padding: 20px;\n  margin-bottom: 20px;\n  border: 1px solid var(--border-color);\n}\n\nh1, h2, h3, h4, h5, h6 {\n  color: var(--primary-color); /* Headings use primary color */\n  margin-top: 0;\n  margin-bottom: 15px;\n}\n\nul {\n  list-style: none;\n  padding: 0;\n  margin: 0;\n}\n\nbutton {\n  background-color: var(--primary-color);\n  color: var(--secondary-color);\n  border: none;\n  padding: 10px 18px;\n  border-radius: 5px;\n  cursor: pointer;\n  font-size: 1em;\n  transition: background-color 0.3s ease, transform 0.2s ease;\n  font-family: 'Roboto Mono', monospace;\n  font-weight: bold;\n}\n\nbutton:hover {\n  background-color: var(--accent-color); /* Accent color on hover */\n  transform: translateY(-2px);\n}\n</style>\n"],"mappings":";;EACOA,EAAE,EAAC,KAAK;EAACC,KAAK,EAAC;;;EACVA,KAAK,EAAC;AAAY;;EACnBA,KAAK,EAAC;AAAU;;EAKjBA,KAAK,EAAC;AAAU;;;;uBAPxBC,mBAAA,CAUM,OAVNC,UAUM,GATJC,mBAAA,CAKS,UALTC,UAKS,GAJPD,mBAAA,CAGM,OAHNE,UAGM,GAFJC,YAAA,CAA2DC,sBAAA;IAA9CC,EAAE,EAAC,GAAG;IAACR,KAAK,EAAC;;sBAAW,MAAQ,KAAAS,MAAA,QAAAA,MAAA,O,iBAAR,UAAQ,mB;;MAC7CC,mBAAA,2DAA8D,C,KAGlEP,mBAAA,CAEO,QAFPQ,UAEO,GADLL,YAAA,CAAcM,sBAAA,E","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}